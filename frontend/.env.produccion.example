# ─────────────────────────────────────────────────────────────────
#  PRODUCCIÓN — tienda de Stilos en Vercel (molde: va a git, sin valores reales)
#
#  Copiá este archivo como ".env.produccion" (queda fuera de git), completalo y en Vercel:
#  Settings → Environment Variables → "Import .env", y volvé a desplegar.
#  Todo lo que empieza con VITE_ es PÚBLICO (queda dentro de la web): nunca claves secretas.
# ─────────────────────────────────────────────────────────────────

# La dirección de la API en Render (la misma que URL_API_RENDER del servidor) + /api al final.
VITE_API_URL=https://[COMPLETAR].onrender.com/api

# Ingreso con Google: el MISMO valor que GOOGLE_ID_CLIENTE del servidor. Vacía = sin botón.
VITE_GOOGLE_ID_CLIENTE=
