# ─────────────────────────────────────────────────────────────────
#  LOCAL — la tienda en tu PC (npm --prefix frontend run dev)
#  Copiá este archivo como ".env.local" (queda fuera de git). Vite lo lee solo.
# ─────────────────────────────────────────────────────────────────

# Tu servidor local, con /api al final.
VITE_API_URL=http://localhost:3001/api

# Ingreso con Google (público; el mismo que GOOGLE_ID_CLIENTE del servidor). Vacía = sin botón.
# El Client ID de Google tiene que tener http://localhost:5173 en "Orígenes autorizados".
VITE_GOOGLE_ID_CLIENTE=
