# ─────────────────────────────────────────────────────────────────
#  LOCAL — tu PC, con PostgreSQL local (molde: va a git, sin valores reales)
#
#  Copiá este archivo como ".env.local" (queda fuera de git). Tiene las mismas variables y en el
#  mismo orden que .env.produccion, con valores de tu PC; al final, lo que solo existe acá.
#  BD_URL_SUPABASE queda vacía a propósito: tu PC nunca se conecta a la base de producción.
#  Revisá los nombres con: npm --prefix servidor run env:verificar
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
# En tu PC sirve cualquier texto; en producción va uno largo y al azar.
CLAVE_SESIONES=CLAVE_SOLO_PARA_MI_PC
# La tienda y la API en tu PC.
URL_FRONTEND_VERCEL=http://localhost:5173
URL_API_RENDER=http://localhost:3001
# Vacía SIEMPRE en este archivo.
BD_URL_SUPABASE=
# Un schema propio de tu PC (ej. mi_proyecto_local): nunca el de producción.
BD_ESQUEMA=[COMPLETAR]
# Super admin de prueba (se crea en tu base local).
SUPERADMIN_USUARIO=admin
SUPERADMIN_CONTRASENA=[COMPLETAR]
# Fotos (opcional en tu PC: sin esto no se pueden subir).
CLOUDINARY_NOMBRE_CUENTA=
CLOUDINARY_CLAVE_API=
CLOUDINARY_SECRETO_API=
# Correo de avisos (Brevo). Opcional en tu PC: vacías = no se manda nada.
CLAVE_API_BREVO=
CORREO_REMITENTE=
# Ingreso con Google (público; el mismo que VITE_GOOGLE_ID_CLIENTE). Vacía = sin botón.
GOOGLE_ID_CLIENTE=

# Solo en tu PC: PostgreSQL local.
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=[COMPLETAR]
DB_USER=postgres
DB_PASS=[COMPLETAR]
