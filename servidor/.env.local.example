# ─────────────────────────────────────────────────────────────────
#  LOCAL — tu PC, con PostgreSQL local
#
#  Copiá este archivo como ".env.local" (queda fuera de git) y completá lo tuyo.
#  Es el ÚNICO archivo que lee el servidor en tu PC: BD_URL_SUPABASE queda vacía a propósito,
#  así tu PC nunca se conecta a la base de producción.
#  Revisá los nombres con: npm --prefix servidor run env:verificar
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
# En tu PC sirve cualquier texto; en producción va uno largo y al azar.
CLAVE_SESIONES=CLAVE_SOLO_PARA_MI_PC
# Tienda local (Vite). En tu PC se permiten los orígenes locales conocidos (localhost:5173…).
URL_FRONTEND_VERCEL=http://localhost:5173

# Super admin de prueba (se crea en tu base local).
SUPERADMIN_USUARIO=admin
SUPERADMIN_CONTRASENA=[COMPLETAR]

# Base de datos: PostgreSQL local. BD_URL_SUPABASE vacía SIEMPRE en este archivo.
BD_URL_SUPABASE=
# Un schema propio de tu PC (ej. mi_proyecto_local): nunca el de producción.
BD_ESQUEMA=[COMPLETAR]
DB_HOST=localhost
DB_PORT=5432
DB_NAME=[COMPLETAR]
DB_USER=postgres
DB_PASS=[COMPLETAR]

# Correo en tu PC (opcional; vacío = no se envía nada).
# Con Gmail: "contraseña de aplicación" de https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fotos (opcional en tu PC: sin esto no se pueden subir). Las mismas tres de Cloudinary.
CLOUDINARY_NOMBRE_CUENTA=
CLOUDINARY_CLAVE_API=
CLOUDINARY_SECRETO_API=

# Ingreso con Google (público; el mismo que VITE_GOOGLE_ID_CLIENTE). Vacía = sin botón.
GOOGLE_ID_CLIENTE=
